; Bloom.theme
; Double-click this file (or right-click > Apply/Install) to apply it in Windows 11.
; It will show up under Settings > Personalization > Themes > Installed themes.
;
; NOTE: The .theme file format only controls the desktop wallpaper (and classic
; Control Panel colors) — it can't set the lock screen image or the modern
; accent color. Use Set-BloomTheme.ps1 alongside this for those two.

[Theme]
DisplayName=Yaru

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\Bloom\bloom.png
WallpaperStyle=10
TileWallpaper=0

[Control Panel\Desktop\WindowMetrics]

[VisualStyles]
Path=%SystemRoot%\resources\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize

[Slideshow]
Interval=1800000
Shuffle=0
